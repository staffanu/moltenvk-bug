#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer InBuf {
    uint inData[];
};

layout(set = 0, binding = 1, std430) writeonly buffer OutBuf {
    uint outData[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= 1024u) return;
    outData[i] = inData[i] ^ 0xA5A5A5A5u;
}
